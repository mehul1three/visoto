# Required only for analysing your own photos.
# The built-in sample level works without it.
# Get one free (no billing account needed) at https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Optional. Defaults to gemini-3.5-flash, which is verified working and takes
# about 13s for a photo. Note that gemini-3.7-flash currently returns
# 503 "experiencing high demand" on most calls — the route falls back to
# gemini-2.5-flash automatically if the primary model is busy.
# GEMINI_MODEL=gemini-3.5-flash
